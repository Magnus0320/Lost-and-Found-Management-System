# Copy to .env and fill in. NEVER commit the real .env.
#
# PostgreSQL only -- the app refuses to start on sqlite:// or mysql:// URLs.
# Inside docker compose the host is the service name `db`; running the API
# on the host against the compose database, use localhost.
DATABASE_URL=postgresql://lostfound:lostfound@localhost:5432/lostfound

# Sign JWTs with this. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Credentials used by docker compose to provision the db service.
POSTGRES_USER=lostfound
POSTGRES_PASSWORD=lostfound
POSTGRES_DB=lostfound
POSTGRES_PORT=5432
API_PORT=8000

# One-time codes for registration + password reset.
OTP_TTL_MINUTES=10

# Outbound mail.
#
# MAIL_ENABLED=false (the default) sends nothing: the API returns the one-time
# code in the response as `otp_debug`, so registration and password reset work
# with no SMTP server. CI and the Playwright e2e test rely on this.
#
# MAIL_ENABLED=true delivers over real SMTP and `otp_debug` is always null.
#
# For Gmail: MAIL_PASSWORD must be a 16-character App Password
# (https://myaccount.google.com/apppasswords) with 2-Step Verification enabled
# -- a normal account password will be rejected. MAIL_FROM must match
# MAIL_USERNAME, since Gmail refuses to send as an unverified address.
MAIL_ENABLED=false
MAIL_FROM=your.address@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_USE_TLS=true
MAIL_TIMEOUT_SECONDS=15

ENVIRONMENT=development
DB_ECHO=false

# Alembic owns the schema. In Docker the entrypoint runs `alembic upgrade head`
# before the API starts. Set this true only if you want the app process itself
# to migrate on boot (convenient with `uvicorn --reload` locally).
RUN_MIGRATIONS_ON_STARTUP=false
